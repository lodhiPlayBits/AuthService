# ═══════════════════════════════════════════════════════════════════
# nginx.env.example — Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════
# Usage:
#   cp nginx.env.example .env
#   docker compose --env-file .env up -d --build
# ═══════════════════════════════════════════════════════════════════

# Your domain name (used for SSL cert generation and server_name)
DOMAIN=authvolt.fun

# Email for Let's Encrypt certificate registration
CERTBOT_EMAIL=you@email.com

# Auth service backend host (container name on the Docker network)
AUTH_BACKEND_HOST=auth-service

# Auth service backend port
AUTH_BACKEND_PORT=8080
