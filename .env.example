# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_URL=jdbc:postgresql://localhost:5432/auth_service
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# ===========================================
# JWT CONFIGURATION
# ===========================================
# CRITICAL: Change this to a strong random secret in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_minimum_256_bits

JWT_ISSUER=api.yourcompany.com
JWT_AUDIENCE=your-auth-service

# Token expiration (in seconds)
JWT_ACCESS_TTL_SECOND=3600
JWT_REFRESH_TTL_SECOND=86400

# Cookie configuration
JWT_REFRESH_TOKEN_COOKIE_NAME=refreshToken
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_DOMAIN=
JWT_COOKIE_PATH=/api/v1/auth

# ===========================================
# HIKARI CONNECTION POOL
# ===========================================
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
HIKARI_LEAK_DETECTION_THRESHOLD=60000

# ===========================================
# SERVER CONFIGURATION
# ===========================================
SERVER_PORT=8080
SERVER_CONNECTION_TIMEOUT=20s
SERVER_MAX_THREADS=200
SERVER_MIN_SPARE_THREADS=10
SERVER_ACCEPT_COUNT=100

# ===========================================
# QUERY TIMEOUTS
# ===========================================
QUERY_TIMEOUT=10000
LOCK_TIMEOUT=5000

# ===========================================
# JPA CONFIGURATION
# ===========================================
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# ===========================================
# LOGGING LEVELS
# ===========================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_AUDIT=INFO
LOG_LEVEL_SPRING_SECURITY=WARN
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_HIBERNATE=WARN
LOG_LEVEL_HIBERNATE_SQL=WARN
LOG_LEVEL_FLYWAY=INFO
LOG_LEVEL_HIKARI=INFO

# ===========================================
# ACTUATOR CONFIGURATION
# ===========================================
ACTUATOR_ENDPOINTS=health,info
ACTUATOR_HEALTH_SHOW_DETAILS=never

# ===========================================
# LOG FILE PATH
# ===========================================
LOG_FILE=/var/log/auth-service/auth-service.log

