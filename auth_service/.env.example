# ===========================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# ===========================================
# Copy this file to:
#   - .env (for local development)
#   - .env.prod (for production)
# And update the values accordingly.
#
# NEVER commit .env or .env.prod files with real secrets!
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Local Direct:         DB_HOST=localhost
# Local Docker:         DB_HOST=host.docker.internal
# Production (AWS EC2): DB_HOST=YOUR_LAPTOP_REACHABLE_IP
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_service
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# ===========================================
# ADMIN CREDENTIALS
# ===========================================
ADMIN_EMAIL=Admin@admin.com
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=your_secure_admin_password

# ===========================================
# JWT CONFIGURATION
# ===========================================
# Generate a secure secret for production:
# openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_min_64_chars

JWT_ISSUER=authvolt.fun
JWT_AUDIENCE=lodhi-auth-service

# Token expiration (in seconds)
JWT_ACCESS_TTL_SECOND=3600
JWT_REFRESH_TTL_SECOND=86400

# Cookie configuration
JWT_REFRESH_TOKEN_COOKIE_NAME=refreshToken
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_DOMAIN=.authvolt.fun
JWT_COOKIE_PATH=/api/v1/auth

# ===========================================
# HIKARI CONNECTION POOL
# ===========================================
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000
HIKARI_LEAK_DETECTION_THRESHOLD=0

# ===========================================
# SERVER CONFIGURATION
# ===========================================
SERVER_PORT=8080
SERVER_CONNECTION_TIMEOUT=20s

# ===========================================
# QUERY TIMEOUTS
# ===========================================
QUERY_TIMEOUT=10000
LOCK_TIMEOUT=5000

# ===========================================
# JPA CONFIGURATION
# ===========================================
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# ===========================================
# LOGGING LEVELS
# ===========================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_AUDIT=INFO
LOG_LEVEL_SPRING_SECURITY=WARN
LOG_LEVEL_SPRING_WEB=WARN
LOG_LEVEL_HIBERNATE=WARN
LOG_LEVEL_HIBERNATE_SQL=WARN
LOG_LEVEL_FLYWAY=INFO
LOG_LEVEL_HIKARI=INFO

# ===========================================
# ACTUATOR CONFIGURATION
# ===========================================
ACTUATOR_ENDPOINTS=health,info,metrics
ACTUATOR_HEALTH_SHOW_DETAILS=when-authorized

# ===========================================
# LOG FILE PATH
# ===========================================
LOG_FILE=logs/auth-service.log


# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TIMEOUT=60000

# Redis connection pool
REDIS_POOL_MAX_ACTIVE=8
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=0
REDIS_POOL_MAX_WAIT=-1ms
REDIS_SHUTDOWN_TIMEOUT=100ms

# Cache configuration (TTL in milliseconds)
CACHE_TTL=3600000

